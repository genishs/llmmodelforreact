# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# 모델 weights (수 GB → Git LFS 또는 제외)
models/base/
models/qwen-react-lora-7b*/

# 학습 체크포인트 (중간 저장 파일)
models/*/checkpoint-*/
models/*/optimizer.pt
models/*/rng_state.pth
models/*/scheduler.pt

# 학습 데이터 (생성 가능하므로 제외)
data/processed/

# 어댑터 대용량 산출물 재발방지 — models/** 아래 checkpoint 외 최종본도 커밋 금지.
# 실물은 git에 올리지 않고 외장하드로 직접 이관한다. (2026-08-01, GH 100MB 제한 반려 사고)
# best-adapters/**는 기존 git-lfs 트래킹 대상이므로 이 규칙에서 제외한다.
models/**/*.safetensors
models/**/tokenizer.json
*.gguf

# 환경 설정
.env
*.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# 로그
*.log
runs/
wandb/

# eval 중간 산출물(재생성 가능)
# ★eval_results/gen/ = 각 어댑터가 실제로 뱉은 산출물의 유일한 영속 기록.
#  '재생성 가능'은 거짓 — 재생성엔 어댑터+GPU+수 시간이 든다. 하니스 v2의 전수 재점수는
#  이 아카이브(.tsx)만으로 GPU 0에 돌아간다 = 프로젝트 최고 가치 자산. 반드시 커밋한다.
#  ⚠️함정(8060 실측): 'eval_results/'처럼 디렉터리를 통째 제외하면 git이 하위를 '!'로
#  되살리지 못한다. 'eval_results/*' + '!eval_results/gen/' 라야 동작한다.
eval_results/*
!eval_results/gen/
.claude/

# tsc 하드평가 npm 의존성(루트 설치분, 재생성 가능)
node_modules/
package-lock.json

# LAN 파일전송 임시 디렉토리 (대용량 어댑터/생성물 — git에 넣지 않음)
comms/lan_xfer/

# ── 어댑터·모델 가중치는 git 에 올리지 않는다 (2026-08-29, 두목 지시)
#    "어댑터 등 크기가 큰 파일들은 외장하드를 직접 연결해주면 이동할 수 있으니
#     git에 무리해서 올리려 하지 말자"
#    정본 보관처 = 2TB USB 아카이브  "새 볼륨"/ai_model/models/adapters
#    ⚠️ 파일을 지우는 것이 아니라 추적만 제외한다. 실물은 절대 삭제 금지.
#    (best-adapters/**/*.safetensors 는 .gitattributes 로 LFS 추적 중 — 여기 제외 대상 아님)
models/**/adapter_model.safetensors
models/**/*.bin
models/**/*.gguf
models/**/tokenizer.json
models/**/tokenizer.model
models/**/optimizer.pt
models/**/scheduler.pt
models/base/
